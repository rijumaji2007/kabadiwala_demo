# Public Firebase Web configuration. These are identifiers, not service-account secrets.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Public canonical URL used for metadata, sitemap, and robots generation.
# NEXT_PUBLIC_APP_URL=https://your-domain.example

# Optional protected server endpoint for image classification. Do not place provider API keys here.
# NEXT_PUBLIC_AI_CLASSIFICATION_ENDPOINT=/api/ai/classify
# NEXT_PUBLIC_AI_CONFIDENCE_THRESHOLD=0.70

# Server-only secrets belong in your deployment secret manager / Cloud Functions environment,
# never in a NEXT_PUBLIC_ variable or committed .env file.
# AI_PROVIDER_API_KEY=
